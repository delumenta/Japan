<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#070c10">

<title>Japan Trip · October 2026</title>

<style>

:root{
  --bg:#070c10;
  --panel:#10161c;
  --panel-light:#151c23;
  --panel-active:#172027;
  --line:#29323b;
  --line-soft:rgba(255,255,255,.07);

  --text:#f5f5f3;
  --muted:#aeb5bc;
  --muted-blue:#91a5b3;

  /* soft muted red — same feeling as Food Finder */
  --red:#c96f68;

  --blue:#5c9dff;
  --green:#67c587;
  --orange:#f4a34d;
}


/* ===============================
   GLOBAL
================================ */

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;

  background:
    radial-gradient(
      circle at 50% -15%,
      #17202a 0%,
      transparent 38%
    ),
    var(--bg);

  color:var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  line-height:1.5;
}

a{
  color:inherit;
}


/* ===============================
   PAGE
================================ */

.page{
  max-width:760px;
  margin:auto;

  padding:
    28px
    14px
    calc(100px + env(safe-area-inset-bottom));
}


/* ===============================
   HERO
================================ */

.hero{
  padding:18px 4px 30px;
}

.eyebrow{
  color:var(--red);

  font-size:11px;
  font-weight:800;

  letter-spacing:.13em;
  text-transform:uppercase;

  margin-bottom:10px;
}

.hero h1{
  margin:0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:42px;
  line-height:1.03;

  letter-spacing:-.035em;

  color:#fff;
}

.hero-description{
  margin:14px 0 0;

  color:var(--muted);
  font-size:15px;

  max-width:540px;
}

.hero-meta{
  display:flex;
  flex-wrap:wrap;

  gap:7px;

  margin-top:18px;
}

.pill{
  border:1px solid var(--line);

  background:rgba(255,255,255,.035);

  border-radius:999px;

  padding:7px 10px;

  color:#ccd3d8;

  font-size:12px;
  font-weight:650;
}


/* ===============================
   SECTION TITLES
================================ */

.section{
  margin-top:4px;
  margin-bottom:30px;
}

.section-label{
  margin:0 2px 10px;

  color:var(--red);

  font-size:11px;
  font-weight:800;

  letter-spacing:.12em;
  text-transform:uppercase;
}


/* ===============================
   MAIN MENU
================================ */

.menu{
  display:grid;
  grid-template-columns:1fr;

  gap:12px;
}

.menu-card{
  position:relative;

  display:block;

  min-height:155px;

  padding:20px;

  text-decoration:none;

  border:1px solid var(--line);
  border-radius:22px;

  background:
    linear-gradient(
      145deg,
      #161e25,
      #0f151a
    );

  box-shadow:
    0 14px 34px rgba(0,0,0,.17);

  overflow:hidden;

  transition:
    transform .18s ease,
    border-color .18s ease,
    background .18s ease;
}

.menu-card:active{
  transform:scale(.985);
}

.menu-icon{
  width:48px;
  height:48px;

  border-radius:14px;

  display:flex;
  align-items:center;
  justify-content:center;

  margin-bottom:18px;

  font-size:23px;

  border:1px solid rgba(201,111,104,.16);

  background:rgba(201,111,104,.10);
}

.menu-card.food .menu-icon{
  background:rgba(92,157,255,.10);
  border-color:rgba(92,157,255,.16);
}

.menu-title{
  color:#fff;

  font-size:20px;
  font-weight:800;

  letter-spacing:-.015em;
}

.menu-description{
  color:var(--muted);

  margin-top:5px;

  font-size:13px;
}

.menu-arrow{
  position:absolute;

  right:19px;
  bottom:18px;

  color:var(--red);

  font-size:22px;
}

.menu-card.food .menu-arrow{
  color:var(--blue);
}


/* ===============================
   TRIP AT A GLANCE
================================ */

.glance{
  border:1px solid var(--line);

  border-radius:20px;

  background:
    linear-gradient(
      145deg,
      #141b21,
      #0e1419
    );

  overflow:hidden;
}

.glance-row{
  display:grid;

  grid-template-columns:72px 43px 1fr;

  align-items:center;

  min-height:72px;

  padding:12px 14px;

  border-bottom:1px solid var(--line-soft);
}

.glance-row:last-child{
  border-bottom:0;
}

.glance-date{
  color:var(--red);

  font-size:12px;
  font-weight:800;
}

.glance-icon{
  font-size:20px;
}

.glance-title{
  color:#fff;

  font-size:14px;
  font-weight:750;
}

.glance-sub{
  color:var(--muted);

  font-size:12px;

  margin-top:2px;
}


/* ===============================
   QUICK NOTE
================================ */

.note{
  display:flex;

  gap:11px;

  align-items:flex-start;

  border:1px solid var(--line);

  border-radius:16px;

  padding:14px;

  background:#10161c;

  color:var(--muted);

  font-size:12px;
}

.note-icon{
  font-size:17px;
  line-height:1.4;
}


/* ===============================
   BOTTOM NAV
================================ */

.bottom-nav{
  position:fixed;

  left:0;
  right:0;
  bottom:0;

  z-index:50;

  background:rgba(10,14,18,.94);

  border-top:1px solid var(--line);

  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);

  padding:
    8px
    12px
    calc(8px + env(safe-area-inset-bottom));
}

.bottom-inner{
  max-width:760px;

  margin:auto;

  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:7px;
}

.bottom-link{
  display:flex;

  align-items:center;
  justify-content:center;

  gap:5px;

  min-height:44px;

  border:1px solid #26333d;
  border-radius:12px;

  background:#121a20;

  color:#cbd2d7;

  text-decoration:none;

  font-size:12px;
  font-weight:750;
}

.bottom-link.active{
  color:var(--red);

  border-color:var(--red);

  background:rgba(201,111,104,.08);
}


/* ===============================
   DESKTOP
================================ */

@media(min-width:650px){

  .page{
    padding-top:42px;
  }

  .hero{
    padding-bottom:38px;
  }

  .hero h1{
    font-size:56px;
  }

  .menu{
    grid-template-columns:1fr 1fr;
  }

  .menu-card{
    min-height:190px;
    padding:23px;
  }

}


/* ===============================
   SMALL MOBILE
================================ */

@media(max-width:390px){

  .hero h1{
    font-size:37px;
  }

  .page{
    padding-left:12px;
    padding-right:12px;
  }

  .glance-row{
    grid-template-columns:66px 38px 1fr;
  }

}

</style>
</head>


<body>

<main class="page">


  <!-- =================================
       HERO
  ================================== -->

  <section class="hero">

    <div class="eyebrow">
      JAPAN · OCTOBER 2026 🇯🇵
    </div>

    <h1>
      Japan Trip
    </h1>

    <p class="hero-description">
      Kyoto, mountain roads, onsen towns, Osaka and the Kiso Valley.
      Everything for the trip in one place.
    </p>

    <div class="hero-meta">

      <div class="pill">
        🗓️ 18–31 Oct
      </div>

      <div class="pill">
        🚗 Road Trip · 23–26
      </div>

      <div class="pill">
        🍁 Autumn Trip
      </div>

    </div>

  </section>



  <!-- =================================
       CHOOSE
  ================================== -->

  <section class="section">

    <div class="section-label">
      What do you need?
    </div>

    <div class="menu">


      <!-- SCHEDULE -->

      <a
        href="schedule.html"
        class="menu-card"
      >

        <div class="menu-icon">
          📅
        </div>

        <div class="menu-title">
          Trip Schedule
        </div>

        <div class="menu-description">
          Where are we going today?
        </div>

        <div class="menu-arrow">
          →
        </div>

      </a>



      <!-- FOOD -->

      <a
        href="food.html"
        class="menu-card food"
      >

        <div class="menu-icon">
          🍽️
        </div>

        <div class="menu-title">
          Kyoto Food Finder
        </div>

        <div class="menu-description">
          Find food by area or cuisine.
        </div>

        <div class="menu-arrow">
          →
        </div>

      </a>


    </div>

  </section>



  <!-- =================================
       TRIP AT A GLANCE
  ================================== -->

  <section class="section">

    <div class="section-label">
      Trip at a glance
    </div>

    <div class="glance">


      <div class="glance-row">

        <div class="glance-date">
          18–22
        </div>

        <div class="glance-icon">
          ⛩️
        </div>

        <div>
          <div class="glance-title">
            Kyoto
          </div>

          <div class="glance-sub">
            Temples · Arashiyama · Ine · Kibune
          </div>
        </div>

      </div>



      <div class="glance-row">

        <div class="glance-date">
          23–26
        </div>

        <div class="glance-icon">
          🚗
        </div>

        <div>
          <div class="glance-title">
            Road Trip
          </div>

          <div class="glance-sub">
            Dorogawa · Ryujin · Kumano · Nachi
          </div>
        </div>

      </div>



      <div class="glance-row">

        <div class="glance-date">
          27–31
        </div>

        <div class="glance-icon">
          🌃
        </div>

        <div>
          <div class="glance-title">
            Osaka
          </div>

          <div class="glance-sub">
            Osaka base · Narai-juku day trip
          </div>
        </div>

      </div>


    </div>

  </section>



  <!-- =================================
       NOTE
  ================================== -->

  <section class="section">

    <div class="note">

      <div class="note-icon">
        💡
      </div>

      <div>
        Use <strong style="color:#fff">Schedule</strong>
        to see today's route and timings.
        Use <strong style="color:#fff">Food</strong>
        when you need somewhere to eat nearby.
      </div>

    </div>

  </section>


</main>



<!-- =================================
     BOTTOM NAV
================================== -->

<nav class="bottom-nav">

  <div class="bottom-inner">

    <a
      href="index.html"
      class="bottom-link active"
    >
      🏠 Home
    </a>

    <a
      href="schedule.html"
      class="bottom-link"
    >
      📅 Schedule
    </a>

    <a
      href="food.html"
      class="bottom-link"
    >
      🍽️ Food
    </a>

  </div>

</nav>


</body>
</html>
